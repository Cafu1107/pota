{
  "name": "pota",
  "private": true,
  "version": "1.1.0",
  "description": "Basketball scores, live games, box scores, shot charts, standings, teams and players across 18 leagues — in Turkish and English.",
  "license": "GPL-3.0-or-later",
  "author": "Cafu1107",
  "homepage": "https://cafu1107.github.io/pota/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cafu1107/pota.git"
  },
  "keywords": [
    "basketball",
    "live-scores",
    "box-score",
    "shot-chart",
    "standings",
    "euroleague",
    "nba",
    "bsl",
    "react",
    "vite",
    "pwa"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/start.mjs",
    "serve": "npm run build && npm start",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
